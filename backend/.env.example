# ── Configuration du backend Mariage Diane & Amon ──────────────────
# Copiez ce fichier en « .env » et adaptez les valeurs.

# Sécurité (OBLIGATOIRE en production)
SECRET_KEY=changez-cette-cle-secrete-longue
ADMIN_USERNAME=admin
ADMIN_PASSWORD=mariage2026

# Base de données (SQLite par défaut)
DATABASE_URL=sqlite:///./wedding.db

# ── WhatsApp Cloud API (Meta) — OPTIONNEL ──────────────────────────
# Sans ces clés, l'API fonctionne en « mode lien » : elle génère des
# liens wa.me clic-à-envoyer (gratuits, ouverts dans WhatsApp).
#
# Pour l'envoi AUTOMATIQUE réel :
# 1. Créez une app sur https://developers.facebook.com → produit « WhatsApp »
# 2. Récupérez votre Phone Number ID et un jeton d'accès permanent
# 3. Décommentez les 2 lignes ci-dessous :
# WHATSAPP_PHONE_ID=123456789012345
# WHATSAPP_API_TOKEN=EAAGxxxxxxxxxxxxxxxx

# ── Notifications des mariés — OPTIONNEL (recommandé) ──────────────
# À chaque RSVP, message du livre d'or ou visite, les mariés reçoivent
# un email et/ou un WhatsApp. Sans configuration, le site fonctionne
# normalement (simplement aucune notification envoyée).
#
# 1) EMAIL (SMTP) — ex. avec une adresse Gmail :
#    créez un mot de passe d'application sur
#    https://myaccount.google.com/apppasswords (2FA activée requise)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=hmkpadonou@gmail.com
# SMTP_PASSWORD=abcd-efgh-ijkl-mnop
NOTIFY_EMAIL_TO=hmkpadonou@gmail.com
#
# 2) WHATSAPP (gratuit, via CallMeBot) — sur le téléphone du numéro
#    à notifier (07 57 67 77 07) :
#    a. Ajoutez aux contacts le numéro du bot affiché sur
#       https://www.callmebot.com/whatsapp.php (ex. +34 644 26 33 77)
#    b. Envoyez-lui : I allow callmebot to send me messages
#    c. Le bot répond avec votre apikey → copiez-la ci-dessous
# CALLMEBOT_APIKEY=123456
NOTIFY_WHATSAPP_TO=+2250757677707
#
# 3) Visites : au plus 1 notification toutes les X minutes (sinon
#    chaque consultation déclencherait un message).
VISIT_NOTIFY_MINUTES=15
#
# Adresse publique du site (utilisé pour les liens dans les emails)
PUBLIC_BASE_URL=https://invitation-mariage-diane-amon.onrender.com

# CORS (origines autorisées, séparées par des virgules ; * = tout le monde)
CORS_ORIGINS=*
